# Recommended official provider for the demo.
# GigaChat automatically exchanges GIGACHAT_AUTH_KEY for a 30-minute access token.
LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-3-Ultra
LLM_BASE_URL=https://api.giga.chat/v1/
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Keep TLS verification enabled in normal use. GigaChat uses the Russian Ministry
# of Digital Development CA chain; on systems that do not trust it, point this
# at an installed PEM bundle. Disabling verification is only a local diagnostic fallback.
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE=/path/to/chain_pem.txt

# Retry transient provider/network failures with bounded exponential backoff.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1

# Generic API variables used by Z.AI / OpenAI-compatible providers.
# They are not the GigaChat Authorization key.
LLM_API_KEY=
LLM_API_KEY_REQUIRED=true

# Alternative: Z.AI
# LLM_PROVIDER=zai
# LLM_MODEL=glm-4.6
# LLM_BASE_URL=https://api.z.ai/api/paas/v4/
# ZAI_API_KEY=
# Backward-compatible Z.AI aliases are supported.
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# Z.AI Coding Plan, only when the account actually has that plan:
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/

MAX_AGENT_STEPS=100
HEADLESS=false
MODEL_TIMEOUT=180

# risky (default), all, or none. Use all for supervised authenticated acceptance.
# none is for disposable test fixtures only; never use it for live transactions.
CONFIRMATION_MODE=risky

# Browser backend: playwright (desktop default), webdriver, or cdp.
BROWSER_BACKEND=playwright

# Optional: system Chromium path for Playwright.
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# WebDriver backend. Useful on Termux/Android with chromedriver + headless_shell.
WEBDRIVER_URL=http://127.0.0.1:9515
WEBDRIVER_BINARY=/data/data/com.termux/files/usr/bin/headless_shell

# Example local OpenAI-compatible router without real authentication:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=your-route-or-model
# LLM_BASE_URL=http://127.0.0.1:8787/v1/
# LLM_API_KEY=local
# LLM_API_KEY_REQUIRED=false
# BROWSER_BACKEND=webdriver

# Authenticated desktop browsing / Russian sites
# cdp: attach to an already running real Chrome/Chromium (recommended for HH/Yandex Mail).
# BROWSER_BACKEND=cdp
# BROWSER_CDP_URL=http://127.0.0.1:9222
# Or use a dedicated persistent Playwright/WebDriver profile directory:
# BROWSER_PROFILE_DIR=./browser-profile
# Or load a Playwright storage-state JSON in non-persistent Playwright mode:
# BROWSER_STORAGE_STATE=./storage-state.json
BROWSER_LOCALE=ru-RU

# Optional: enables upload_file only for files under this operator-approved directory.
# BROWSER_UPLOAD_ROOT=C:\Users\you\Documents\BrowserAgentUploads

# Context budget for each browser observation sent to the LLM.
# Lower this for providers with strict token/rate limits (for example, 8000).
OBSERVATION_BUDGET=28000
